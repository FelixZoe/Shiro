# Server-side Core API address. Docker Compose uses its internal DNS name:
#   http://core:2333/api/v3
NEXT_PUBLIC_API_URL=http://localhost:2333/api/v3

# Browser-accessible Core API and Socket.IO gateway. Use public HTTPS URLs in
# production; the browser cannot resolve Docker service names.
NEXT_PUBLIC_CLIENT_API_URL=http://localhost:2333/api/v3
NEXT_PUBLIC_GATEWAY_URL=http://localhost:2333

# Optional Shiro server integrations
TMDB_API_KEY=
GH_TOKEN=
WEBHOOK_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
