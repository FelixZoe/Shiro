# Copy this file to `.env` before running Docker Compose.
#
# Generate secure values:
#   JWT_SECRET:  openssl rand -base64 48
#   ENCRYPT_KEY: openssl rand -hex 32

TZ=Asia/Shanghai

# Published host ports
SHIRO_PORT=2323
CORE_PORT=2333

# URLs reachable from the visitor's browser. In production, use HTTPS domains.
# Do not use Docker service names such as `core` here.
PUBLIC_CORE_ORIGIN=http://localhost:2333
PUBLIC_CORE_API_URL=http://localhost:2333/api/v3

# Comma-separated hostnames accepted by Core, without URL paths.
# Add the Shiro public hostname when deploying behind a reverse proxy.
ALLOWED_ORIGINS=localhost,127.0.0.1

# Core security. Replace both values before first startup.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
ENCRYPT_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
ENCRYPT_ENABLE=false

# PostgreSQL 16
POSTGRES_USER=mx
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=mx_core

# Unique value from 0 to 1023 when several Core instances write to one DB.
SNOWFLAKE_WORKER_ID=1

# Optional Core cache headers
CDN_CACHE_HEADER=true
FORCE_CACHE_HEADER=false

# Optional Shiro integrations
TMDB_API_KEY=
GH_TOKEN=
WEBHOOK_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
